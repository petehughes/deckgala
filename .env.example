# Shared PostgreSQL connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/deckgala?schema=public"

# Centralized Authentication & Session Management
BETTER_AUTH_SECRET="replace-with-a-random-secret-key-at-least-32-chars-long"
COOKIE_DOMAIN=".deckgala.com" # Leave empty or undefined for localhost testing

# Cross-Subdomain Domain Routing (DNS / Vercel Mappings)
AUTH_URL="https://auth.deckgala.com"     # apps/auth   (Port 3001 in dev)
MY_URL="https://my.deckgala.com"         # apps/my     (Port 3002 in dev)
MYCLUB_URL="https://myclub.deckgala.com" # apps/myclub (Port 3000 in dev)
RESULTS_URL="https://results.deckgala.com" # apps/results (Port 3003 in dev)
WWW_URL="https://www.deckgala.com"       # apps/www    (Port 3004 in dev)
API_URL="https://api.deckgala.com"       # apps/api    (Port 8080 in dev)

# Backend API Configuration
API_BEARER_TOKEN="replace-with-a-random-local-api-token"
CORS_ORIGIN="*"

# Optional OAuth Provider Credentials
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APPLE_CLIENT_ID=""
# APPLE_CLIENT_SECRET=""

# Optional Stripe Integration
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
