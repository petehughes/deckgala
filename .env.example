# Shared local PostgreSQL connection. Use the same database for the API and portal.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/deckgala?schema=public"

# Local API authentication. Replace with a random value before using real data.
API_BEARER_TOKEN="replace-with-a-random-local-api-token"

# Local-only browser access. Tighten this to the deployed results origin in production.
CORS_ORIGIN="*"
