# ==========================================
# Node / Web Build
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Production build output (if using a bundler like Vite, Webpack, etc.)
dist/
# Note: Do NOT ignore `www/` if you are writing raw web files directly in it!
# If `www/` is generated by a build step (e.g. Vite/Angular/React), uncomment the next line:
# www/

# Environment files
.env
.env.local
.env.*.local

# ==========================================
# Capacitor Common
# ==========================================
# Capacitor automatically copies web assets into native subfolders.
# These folders are ephemeral and regenerated on `npx cap sync`.
android/app/src/main/assets/public/
ios/App/App/public/
ios/App/public/

# Capacitor config backups & temporary files
capacitor.config.json.bak
capacitor.config.ts.bak

# ==========================================
# Android
# ==========================================
# Gradle & Android Studio build outputs
android/.gradle/
android/build/
android/*/build/
android/app/build/
android/.idea/
android/*.iml
android/*/*.iml
android/local.properties
android/.cxx/

# Gradle cache & daemon files
android/.gradle-build/
android/captures/

# Signing keys & keystores (CRITICAL: NEVER commit your keystore)
*.jks
*.keystore
android/app/release/
android/app/*.jks
android/app/*.keystore

# ==========================================
# iOS / macOS
# ==========================================
# Xcode user-specific data & schemes
ios/App/*.xcodeproj/*xcuserdata/
ios/App/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/*.xcworkspace/xcuserdata/

# Xcode build output & derived data
ios/App/build/
ios/App/DerivedData/
*.moved-builder

# CocoaPods artifacts (Pods folder is large; install via `pod install`)
ios/App/Pods/
ios/App/Podfile.lock

# Fastlane (if added later)
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots/
ios/fastlane/test_output/

# Certificates & App Store private keys
*.p12
*.cer
*.mobileprovision
*.p8

# ==========================================
# OS & Editor Metadata
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# VS Code / JetBrains / IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace