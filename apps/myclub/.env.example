DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/deckgala?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
