generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClubRole {
  ADMIN
  COACH
  TIMEKEEPER
  OFFICIAL
  PARENT
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PoolCourse {
  SHORT_COURSE_METERS
  LONG_COURSE_METERS
  SHORT_COURSE_YARDS
}

enum Gender {
  FEMALE
  MALE
  OPEN
  OTHER
}

enum SwimStroke {
  FREESTYLE
  BACKSTROKE
  BREASTSTROKE
  BUTTERFLY
  INDIVIDUAL_MEDLEY
}

enum ResultStatus {
  OFFICIAL
  UNOFFICIAL
  DISQUALIFIED
  DID_NOT_FINISH
  DID_NOT_START
}

model Club {
  id               String           @id @default(cuid())
  name             String
  shortName        String?
  code             String?          @unique
  subscriptionTier String?
  customBranding   Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  memberships      ClubMembership[]
  invitations      ClubInvitation[]
  members          Member[]
  swimmers         Swimmer[]
  squads           Squad[]
  venues           Venue[]
  galas            Gala[]
  deckSessions     DeckSession[]
  trainingSchedules TrainingSchedule[]
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  emailVerified         Boolean          @default(false)
  name                  String
  image                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  memberships           ClubMembership[]
  member                Member?
  sessions              Session[]
  accounts              Account[]
  createdClubInvitations ClubInvitation[] @relation("ClubInvitationCreator")
  billingAccount        BillingAccount?
  parentSwimmerLinks    ParentSwimmerLink[]
  pushSubscriptions     PushSubscription[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model ClubMembership {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      ClubRole
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model ClubInvitation {
  id                 String      @id @default(cuid())
  clubId             String
  createdByUserId    String
  tokenHash          String      @unique
  role               ClubRole    @default(COACH)
  expiresAt          DateTime
  acceptedAt         DateTime?
  createdAt          DateTime    @default(now())
  club               Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy          User        @relation("ClubInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([clubId, expiresAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BillingAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique
  stripeCustomerId      String?  @unique
  stripeSubscriptionId  String?  @unique
  subscriptionStatus    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Member {
  id                    String   @id @default(cuid())
  clubId                String
  userId                String?  @unique
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  governingBodyId       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  membershipExpiresAt   DateTime? @db.Date
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  club                  Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  swimmer               Swimmer?

  @@unique([clubId, governingBodyId])
  @@index([clubId, lastName, firstName])
}

model Squad {
  id          String    @id @default(cuid())
  clubId      String
  name        String
  description String?
  coachName   String?
  schedule    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  swimmers    Swimmer[]
  trainingSchedules TrainingSchedule[]

  @@unique([clubId, name])
  @@index([clubId])
}

model Swimmer {
  id              String         @id @default(cuid())
  clubId          String
  memberId        String?        @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime?      @db.Date
  gender          Gender?
  governingBodyId String?
  squadId         String?
  squad           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  club            Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member          Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  squadRel        Squad?         @relation(fields: [squadId], references: [id], onDelete: SetNull)
  personalBests   PersonalBest[]
  raceResults     RaceResult[]
  galaEntries     GalaEntry[]
  parentLinks     ParentSwimmerLink[]

  @@unique([clubId, governingBodyId])
  @@index([clubId, lastName, firstName])
  @@index([squadId])
}

model Venue {
  id           String   @id @default(cuid())
  clubId       String
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  country      String?  @default("United Kingdom")
  latitude     Float?
  longitude    Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  galas        Gala[]
  trainingSchedules TrainingSchedule[]

  @@unique([clubId, name])
  @@index([clubId])
}

model PersonalBest {
  id         String     @id @default(cuid())
  swimmerId  String
  stroke     SwimStroke
  distance   Int
  course     PoolCourse
  timeMs     Int
  achievedAt DateTime?  @db.Date
  meetName   String?
  createdAt  DateTime   @default(now())
  swimmer    Swimmer    @relation(fields: [swimmerId], references: [id], onDelete: Cascade)

  @@index([swimmerId, stroke, distance, course])
}

model Gala {
  id                   String       @id @default(cuid())
  clubId               String
  name                 String
  venue                String?
  venueId              String?
  course               PoolCourse
  startsAt             DateTime
  endsAt               DateTime?
  entryFeePence        Int          @default(0)
  defaultEventFeePence Int          @default(0)
  ageRule              String       @default("AGE_DAY_OF_MEET")
  isPublic             Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  club                 Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  venueRef             Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  events               Event[]
  entries              GalaEntry[]

  @@index([clubId, startsAt])
  @@index([venueId])
}

model Event {
  id                 String       @id @default(cuid())
  galaId             String
  eventNumber        Int
  sessionNumber      Int          @default(1)
  sessionEventNumber Int?
  name               String
  distance           Int
  stroke             SwimStroke
  gender             Gender?
  ageGroup           String?
  minAge             Int?
  maxAge             Int?
  feePence           Int?
  qualifyingTimeMs   Int?
  cutoffTimeMs       Int?
  allowNoTime        Boolean      @default(true)
  createdAt          DateTime     @default(now())
  gala               Gala         @relation(fields: [galaId], references: [id], onDelete: Cascade)
  results            RaceResult[]
  entries            EventEntry[]

  @@unique([galaId, eventNumber])
  @@index([galaId, eventNumber])
  @@index([galaId, sessionNumber])
}

enum EntryStatus {
  SUBMITTED
  CONFIRMED
  PENDING_PAYMENT
  PAID
  WITHDRAWN
}

model GalaEntry {
  id            String       @id @default(cuid())
  galaId        String
  swimmerId     String
  userId        String?
  status        EntryStatus  @default(SUBMITTED)
  totalFeePence Int          @default(0)
  isPaid        Boolean      @default(false)
  paymentMethod String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  gala          Gala         @relation(fields: [galaId], references: [id], onDelete: Cascade)
  swimmer       Swimmer      @relation(fields: [swimmerId], references: [id], onDelete: Cascade)
  eventEntries  EventEntry[]

  @@unique([galaId, swimmerId])
  @@index([galaId])
  @@index([swimmerId])
}

model EventEntry {
  id          String      @id @default(cuid())
  galaEntryId String
  eventId     String
  swimmerId   String
  seedTimeMs  Int?
  feePence    Int         @default(0)
  status      EntryStatus @default(SUBMITTED)
  heat        Int?
  lane        Int?
  createdAt   DateTime    @default(now())
  galaEntry   GalaEntry   @relation(fields: [galaEntryId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([galaEntryId, eventId])
  @@index([eventId])
}

model DeckSession {
  id        String       @id @default(cuid())
  clubId    String
  clientId  String
  name      String
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  results   RaceResult[]

  @@unique([clubId, clientId])
  @@index([clubId, startedAt])
}

model RaceResult {
  id             String       @id @default(cuid())
  eventId        String?
  deckSessionId  String?
  swimmerId      String?
  clientId       String?
  swimmerName    String
  heat           Int?
  lane           Int?
  timeMs         Int?
  seedTimeMs     Int?
  sessionDate    DateTime?      @db.Date
  sessionTime    String?
  setName        String?
  rep            Int?
  targetTimeSec  Float?
  finishWallMs   Int?
  status         ResultStatus @default(UNOFFICIAL)
  infractionCode String?
  notes          String?
  recordedAt     DateTime     @default(now())
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deckSession    DeckSession? @relation(fields: [deckSessionId], references: [id], onDelete: Cascade)
  swimmer        Swimmer?     @relation(fields: [swimmerId], references: [id], onDelete: SetNull)
  splits         RaceSplit[]

  @@unique([deckSessionId, clientId])
  @@index([eventId, heat, lane])
  @@index([swimmerId, recordedAt])
}

model RaceSplit {
  id           String     @id @default(cuid())
  raceResultId String
  splitNumber  Int
  distance     Int?
  timeMs       Int
  recordedAt   DateTime?
  raceResult   RaceResult @relation(fields: [raceResultId], references: [id], onDelete: Cascade)

  @@unique([raceResultId, splitNumber])
}

model ParentSwimmerLink {
  id               String               @id @default(cuid())
  userId           String
  swimmerId        String
  relationship     GuardianRelationship @default(GUARDIAN)
  isPrimaryContact Boolean              @default(true)
  canEnterGalas    Boolean              @default(true)
  emergencyContact Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  swimmer          Swimmer              @relation(fields: [swimmerId], references: [id], onDelete: Cascade)

  @@unique([userId, swimmerId])
  @@index([userId])
  @@index([swimmerId])
}

model TrainingSchedule {
  id             String    @id @default(cuid())
  clubId         String
  squadId        String?
  dayOfWeek      DayOfWeek
  startTime      String
  endTime        String
  venueId        String?
  venueName      String?
  laneAllocation String?
  coachName      String?
  drills         String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  club           Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  squad          Squad?    @relation(fields: [squadId], references: [id], onDelete: SetNull)
  venueRef       Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([clubId, dayOfWeek])
  @@index([squadId])
  @@index([venueId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

